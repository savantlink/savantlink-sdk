{
  "name": "@savantlink/sdk",
  "version": "1.0.8",
  "description": "A package that contains reusables components and services of the Savantlink design system and architecture",
  "homepage": "https://github.com/savantlink/savantlink-sdk.git",
  "files": [
    "dist/**/*",
    "scss/**/*",
    "icons/**/*",
    "README.md"
  ],
  "repository": {
    "url": "git+https://github.com/savantlink/savantlink-sdk.git",
    "type": "git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rimraf dist && NODE_ENV=production rollup --config",
    "lint": "eslint src && stylelint ./src/**/*.scss ./scss/**/*.scss",
    "lint:fix": "eslint src --fix && stylelint ./src/**/*.scss ./scss/**/*.scss --fix",
    "prepare": "husky install",
    "storybook": "start-storybook -p 6006 -s public",
    "storybook:build": "build-storybook -s public",
    "test": "jest",
    "prepublishOnly": "yarn lint && yarn build",
    "analyze": "react-scripts build && npx webpack-bundle-analyzer build/static/js/*.js"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "clsx": "^1.2.1",
    "web-vitals": "^2.1.0"
  },
  "devDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@rollup/plugin-alias": "^4.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@storybook/addon-a11y": "^6.5.16",
    "@storybook/addon-actions": "^6.5.16",
    "@storybook/addon-essentials": "^6.5.16",
    "@storybook/addon-interactions": "^6.5.16",
    "@storybook/addon-links": "^6.5.16",
    "@storybook/builder-webpack5": "^6.5.16",
    "@storybook/manager-webpack5": "^6.5.16",
    "@storybook/node-logger": "^6.5.16",
    "@storybook/preset-create-react-app": "^4.1.2",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/react": "^6.5.16",
    "@storybook/testing-library": "^0.0.13",
    "@svgr/rollup": "^6.5.1",
    "@svgr/webpack": "^6.5.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "babel-plugin-named-exports-order": "^0.0.2",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.6.10",
    "husky": "^8.0.0",
    "jest": "^29.4.1",
    "jest-css-modules": "^2.1.0",
    "postcss": "^8.4.21",
    "prop-types": "^15.8.1",
    "rimraf": "^4.1.2",
    "rollup": "^2.60.2",
    "rollup-plugin-node-externals": "^5.1.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.34.1",
    "sass": "1.54.8",
    "sass-loader": "10.1.1",
    "stylelint": "^14.16.1",
    "stylelint-config-css-modules": "^4.1.0",
    "stylelint-config-recess-order": "^3.1.0",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-config-standard-scss": "^6.1.0",
    "stylelint-scss": "^4.3.0",
    "ts-jest": "^29.0.5",
    "ttypescript": "^1.5.15",
    "typescript": "^4.4.2",
    "typescript-transform-paths": "^3.4.6",
    "webpack": "^5.75.0",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
